{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "resolveJsonModule": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "types": ["vite/client", "bun"], "noEmit": true
  },
  "include": ["src", "projects", "render", "vite.config.ts"]
}
